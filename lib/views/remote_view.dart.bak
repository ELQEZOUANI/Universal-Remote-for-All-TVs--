          ),
          _miniBtn(
            CupertinoIcons.play_fill,
            () => provider.sendKey(RemoteKey.play),
          ),
          _miniBtn(
            CupertinoIcons.pause_fill,
            () => provider.sendKey(RemoteKey.pause),
          ),
          _miniBtn(
            CupertinoIcons.stop_fill,
            () => provider.sendKey(RemoteKey.stop),
          ),
          _miniBtn(
            CupertinoIcons.forward_fill,
            () => provider.sendKey(RemoteKey.fastForward),
          ),
