              widget.icon,
              color: _pressed ? AppTheme.emerald : AppTheme.white,
              size: 20,
            ),
          ),
        ),
        const SizedBox(height: 6),
        Text(
          widget.label,
          style: const TextStyle(color: AppTheme.grey, fontSize: 10),
        ),
      ],
    );
  }
}
